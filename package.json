{
  "name": "strokebot7070",
  "version": "0.79.0",
  "private": true,
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild ./src/app.jsx --bundle --minify --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=./assets/app.min.js",
    "build:css": "tailwindcss -i ./src/styles.css -o ./assets/styles.min.css --minify"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "tailwindcss": "3.4.17"
  }
}
